APP_NAME={{name}}
APP_ENV=production
APP_DEBUG=false
# APP_KEY is generated at deploy time and uploaded as a Worker secret
# by `skyforge deploy` — never commit a real one.
#
# Database / cache / storage drivers are selected by skyforge.json;
# the workersphp Laravel bridge activates them only when configured:
#   d1 -> DB_CONNECTION=cfd1   (database "DB" binding)
#   r2 -> FILESYSTEM_DISK=r2   (bucket "STORAGE" binding)
#   kv -> CACHE_STORE=kv       (namespace "CACHE" binding)
