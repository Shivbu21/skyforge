{"bin":{"skyforge":"skyforge/bin/skyforge.mjs"},"description":"Skyforge — open-source kit for deploying PHP apps on Cloudflare Workers with R2 storage. Runtime forked from workersphp/core (MIT).","devDependencies":{"wrangler":"^4.123.0"},"name":"skyforge","private":true,"scripts":{"hello:deploy":"wrangler deploy -c examples/hello/wrangler.jsonc","hello:dev":"wrangler dev -c examples/hello/wrangler.jsonc","hello:startup":"wrangler check startup -c examples/hello/wrangler.jsonc","probe:beta":"node tools/probe.mjs --target beta --rw","probe:prod":"node tools/probe.mjs --target prod","test":"node --experimental-wasm-jspi --test packages/runtime/test/*.test.mjs packages/cli/test/*.test.mjs skyforge/test/*.test.mjs","test:skyforge":"node --test skyforge/test/*.test.mjs"},"type":"module","version":"0.1.0","workspaces":["packages/*"]}